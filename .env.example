# Browser-safe configuration only. Never place service-role, Firebase Admin, FCM server,
# WhatsApp, or other privileged credentials in this file or a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase web configuration only; keep server credentials in Supabase Edge Function secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
